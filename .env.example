# ─── Supabase ────────────────────────────────────────────────────────────────
# Find all of these in your Supabase project:
#   Dashboard → Settings → API

# Your project ref (the part before .supabase.co)
SUPABASE_PROJECT_ID="your-project-ref"

# Project URL
SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# Anon / public key  (safe to expose in the browser)
SUPABASE_PUBLISHABLE_KEY="eyJhbGci..."
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGci..."

# Service role key  ⚠️  SECRET — never commit this, never expose to the browser
# Required for:
#   - /api/public/auth/signup (creates email-confirmed users server-side)
#   - cron jobs (recaps, pulses, push notifications)
#   - running migrations that change schema/triggers
# Dashboard → Settings → API → "service_role" key
SUPABASE_SERVICE_ROLE_KEY="eyJhbGci..."
